{
  "manifest_version": 3,
  "name": "FlowVeo - Google Labs Flow Companion",
  "version": "1.0.0",
  "description": "Enterprise multi-account session virtualization, tier selector, and video exporter for Google Labs Flow (Veo 3.1)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FlowVeo Control Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.google.com/*",
    "http://localhost:3001/*",
    "http://localhost:5173/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/tools/flow/*"
      ],
      "css": [
        "content/mask-profile.css"
      ],
      "js": [
        "content/mask-profile.js",
        "content/flow-injector.js",
        "content/export-helper.js"
      ],
      "run_at": "document_start"
    }
  ]
}
